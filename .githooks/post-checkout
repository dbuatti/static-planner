#!/bin/bash
# Post-checkout hook: keep index.html/page.html/data/schedule.js group-writable
# so the TOWN daemon (danieletown) can keep writing the schedule. git reset
# --hard / checkout regenerate these as -rw-r--r-- owned by the committer,
# which silently breaks TOWN's next planner write. Re-applies group write as
# the (file) owner. Best-effort: only the owner can chmod, so this is a no-op
# when TOWN itself triggers a checkout (it can't chmod Daniele's files anyway).
for f in index.html page.html data/schedule.js; do
  chmod g+w "$f" 2>/dev/null
done
exit 0
